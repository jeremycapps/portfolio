{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facia.answer-set/2",
  "title": "Facia AnswerSet v2",
  "description": "Canonical, closed, renderer-neutral schema for facia.answer-set/2.",
  "$comment": "Structural validation owns envelope and contract-object closure, role alignment, actionability/operation cardinality, singular/structure exclusion, exact sequenceKind coupling, field container shapes, condition exclusivity, and trace record shapes. Runtime semantic validation owns unique operation ids, cross-bucket field uniqueness, declared promotion targets, item-local payload references, history cardinality/order, and convergence provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "question",
    "answerType",
    "path",
    "inspection",
    "actionable",
    "items",
    "operations"
  ],
  "properties": {
    "schema": { "const": "facia.answer-set/2" },
    "question": { "$ref": "#/$defs/nonEmptyString" },
    "answerType": {
      "enum": ["value", "verdict", "operation", "convergence"]
    },
    "path": { "enum": ["meaning", "execution"] },
    "inspection": { "enum": ["none", "available"] },
    "actionable": { "type": "boolean" },
    "items": {
      "type": "array",
      "minItems": 1
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operationDescriptor" }
    },
    "structure": { "enum": ["dimension", "group", "sequence"] },
    "sequenceKind": { "enum": ["temporal", "dependency", "trace"] },
    "trace": { "$ref": "#/$defs/trace" },
    "density": { "enum": [1, 2, 3] }
  },
  "allOf": [
    {
      "if": {
        "required": ["answerType"],
        "properties": { "answerType": { "const": "value" } }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/valueAnswer" }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answerType"],
        "properties": { "answerType": { "const": "verdict" } }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/verdictAnswer" }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answerType"],
        "properties": { "answerType": { "const": "operation" } }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/operationAnswer" }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answerType"],
        "properties": { "answerType": { "const": "convergence" } }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/convergenceAnswer" }
          }
        }
      }
    },
    {
      "$comment": "A one-item answer is singular, regardless of optional discriminators, so structure and sequenceKind are structurally forbidden.",
      "if": {
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "minItems": 1, "maxItems": 1 }
        }
      },
      "then": {
        "properties": {
          "structure": false,
          "sequenceKind": false
        }
      }
    },
    {
      "$comment": "sequenceKind is present exactly for sequence structure.",
      "if": {
        "required": ["structure"],
        "properties": { "structure": { "const": "sequence" } }
      },
      "then": {
        "required": ["sequenceKind"],
        "properties": { "sequenceKind": true }
      },
      "else": { "properties": { "sequenceKind": false } }
    },
    {
      "$comment": "actionable is exactly equivalent to having one or more operation descriptors.",
      "if": {
        "required": ["actionable"],
        "properties": { "actionable": { "const": true } }
      },
      "then": {
        "properties": { "operations": { "type": "array", "minItems": 1 } }
      },
      "else": {
        "properties": { "operations": { "type": "array", "maxItems": 0 } }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["transform", "transition"] }
      },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "fieldKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^.]+$"
    },
    "fieldKeyList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fieldKey" }
    },
    "fieldPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "supporting", "audit"],
      "properties": {
        "primary": { "$ref": "#/$defs/fieldKeyList" },
        "secondary": { "$ref": "#/$defs/fieldKeyList" },
        "supporting": { "$ref": "#/$defs/fieldKeyList" },
        "audit": { "$ref": "#/$defs/fieldKeyList" }
      }
    },
    "equalsCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "$ref": "#/$defs/fieldKey" },
        "equals": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "isFalseCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "isFalse"],
      "properties": {
        "field": { "$ref": "#/$defs/fieldKey" },
        "isFalse": { "const": true }
      }
    },
    "isNonEmptyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "isNonEmpty"],
      "properties": {
        "field": { "$ref": "#/$defs/fieldKey" },
        "isNonEmpty": { "const": true }
      }
    },
    "promotionCondition": {
      "oneOf": [
        { "$ref": "#/$defs/equalsCondition" },
        { "$ref": "#/$defs/isFalseCondition" },
        { "$ref": "#/$defs/isNonEmptyCondition" }
      ]
    },
    "promotionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "promote"],
      "properties": {
        "when": { "$ref": "#/$defs/promotionCondition" },
        "promote": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/fieldKey" }
        }
      }
    },
    "fieldInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority"],
      "properties": {
        "priority": { "$ref": "#/$defs/fieldPriority" },
        "promotion": {
          "type": "array",
          "items": { "$ref": "#/$defs/promotionRule" }
        }
      }
    },
    "operationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "operationDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "invocation", "reference"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "invocation": { "enum": ["model-operation", "host-callback"] },
        "reference": { "$ref": "#/$defs/nonEmptyString" },
        "inputSchema": { "$ref": "#/$defs/jsonObject" },
        "confirmation": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "valueAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload", "value"],
      "properties": {
        "type": { "const": "Value" },
        "payload": { "$ref": "#/$defs/jsonObject" },
        "value": { "$ref": "#/$defs/jsonValue" },
        "evidence": { "$ref": "#/$defs/jsonValue" },
        "fields": { "$ref": "#/$defs/fieldInfo" }
      }
    },
    "legacyBooleanVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "payload", "conforms"],
      "properties": {
        "type": { "const": "Verdict" },
        "contract": { "const": "LegacyBooleanVerdictV0" },
        "payload": { "$ref": "#/$defs/jsonObject" },
        "conforms": { "type": "boolean" },
        "finding": { "$ref": "#/$defs/jsonValue" },
        "reason": { "$ref": "#/$defs/jsonValue" },
        "expected": { "$ref": "#/$defs/jsonValue" },
        "actual": { "$ref": "#/$defs/jsonValue" },
        "evidence": { "$ref": "#/$defs/jsonValue" },
        "fields": { "$ref": "#/$defs/fieldInfo" }
      }
    },
    "boundedVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "payload", "state"],
      "properties": {
        "type": { "const": "Verdict" },
        "contract": { "const": "BoundedVerdictV1" },
        "payload": { "$ref": "#/$defs/jsonObject" },
        "state": { "$ref": "#/$defs/nonEmptyString" },
        "conforms": { "type": "boolean" },
        "finding": { "$ref": "#/$defs/jsonValue" },
        "reason": { "$ref": "#/$defs/jsonValue" },
        "expected": { "$ref": "#/$defs/jsonValue" },
        "actual": { "$ref": "#/$defs/jsonValue" },
        "evidence": { "$ref": "#/$defs/jsonValue" },
        "fields": { "$ref": "#/$defs/fieldInfo" }
      }
    },
    "verdictAnswer": {
      "oneOf": [
        { "$ref": "#/$defs/legacyBooleanVerdict" },
        { "$ref": "#/$defs/boundedVerdict" }
      ]
    },
    "operationAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload", "operation", "input", "output"],
      "properties": {
        "type": { "const": "Operation" },
        "payload": { "$ref": "#/$defs/jsonObject" },
        "operation": { "$ref": "#/$defs/operationRecord" },
        "input": { "$ref": "#/$defs/jsonValue" },
        "output": { "$ref": "#/$defs/jsonValue" },
        "before": { "$ref": "#/$defs/jsonValue" },
        "after": { "$ref": "#/$defs/jsonValue" },
        "evidence": { "$ref": "#/$defs/jsonValue" },
        "fields": { "$ref": "#/$defs/fieldInfo" }
      }
    },
    "convergenceAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "payload", "state"],
      "properties": {
        "type": { "const": "Convergence" },
        "payload": { "$ref": "#/$defs/jsonObject" },
        "state": { "enum": ["converging", "diverging", "stalled", "reached"] },
        "goal": { "$ref": "#/$defs/jsonValue" },
        "from": { "$ref": "#/$defs/jsonValue" },
        "to": { "$ref": "#/$defs/jsonValue" },
        "evidence": { "$ref": "#/$defs/jsonValue" },
        "fields": { "$ref": "#/$defs/fieldInfo" }
      }
    },
    "traceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "value"],
      "properties": {
        "step": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "directTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "entries"],
      "properties": {
        "kind": { "const": "direct" },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/traceEntry" }
        }
      }
    },
    "historyRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIndex", "trace"],
      "properties": {
        "itemIndex": { "type": "integer", "minimum": 0 },
        "trace": { "$ref": "#/$defs/directTrace" }
      }
    },
    "historyTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "records"],
      "properties": {
        "kind": { "const": "history" },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/historyRecord" }
        }
      }
    },
    "trace": {
      "oneOf": [
        { "$ref": "#/$defs/directTrace" },
        { "$ref": "#/$defs/historyTrace" }
      ]
    }
  }
}
