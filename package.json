{
  "name": "@workspace/context-portfolio-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gen:profile": "node scripts/gen-profile.mjs",
    "gen:blog": "node scripts/gen-blog.mjs",
    "gen:stratos": "node --import tsx scripts/gen-stratos-recipes.ts",
    "gen:resume-default": "node --import tsx scripts/gen-resume-default.ts",
    "build:facia": "npm run build --workspace packages/facia-core",
    "predev": "npm run gen:profile && npm run gen:blog && npm run build:facia && npm run gen:stratos && npm run gen:case-sources && npm run gen:resume-default",
    "dev": "vite",
    "prebuild": "npm run context:reindex-if-requested && npm run gen:profile && npm run gen:blog && npm run build:facia && npm run gen:stratos && npm run gen:case-sources && npm run gen:resume-default",
    "build:client": "vite build",
    "build:server": "vite build --config vite.ssr.config.ts",
    "build": "npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "pretypecheck": "npm run build:facia",
    "typecheck:app": "tsc --noEmit",
    "typecheck:facia": "npm run test:types --workspace packages/facia-core",
    "typecheck": "npm run typecheck:app && npm run typecheck:facia",
    "test:app": "vitest run",
    "test:facia": "npm run test --workspace packages/facia-core",
    "test:e2e": "playwright test",
    "pretest": "npm run build:facia",
    "test": "npm run test:app && npm run test:facia",
    "preeval": "npm run gen:profile",
    "eval": "node --import tsx eval/run.ts",
    "context:normalize": "node scripts/context-normalize.mjs",
    "context:build": "node scripts/context-build-index.mjs",
    "context:search-build": "node scripts/context-build-search-db.mjs",
    "context:reindex-if-requested": "node scripts/context-reindex-r2.mjs",
    "context:upload": "node scripts/context-upload.mjs",
    "verify:chat-context-prod": "node scripts/verify-chat-context-prod.mjs",
    "sync:github": "node --import tsx scripts/github-activity-sync.ts",
    "gen:case-sources": "node --import tsx scripts/gen-case-sources.ts",
    "audit:case-sources": "node --import tsx scripts/audit-case-sources.ts",
    "merge:safe": "bash scripts/safe-merge.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "wouter": "^3.3.5",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@facia/core": "0.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "aws4fetch": "^1.0.20",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
