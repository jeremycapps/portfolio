# Server-side only — never exposed to the browser.
OPENROUTER_API_KEY=your-openrouter-key
# Optional overrides:
# CHAT_PROVIDER=openrouter
# CHAT_MODEL=meta-llama/llama-3.3-70b-instruct
# CHAT_MAX_OUTPUT_TOKENS=400
# STRUCTURED_ANSWER_MAX_OUTPUT_TOKENS=1000

# Rate limiting (optional). When both are set, chat is limited to 20 sends/min
# per client IP via Upstash Redis. When unset, rate limiting is OFF (fail-open).
# Create a free Redis DB at https://console.upstash.com and copy its REST creds.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Context-index storage (api/context-query — Cloudflare R2, S3-compatible).
# Required only for that endpoint; everything else runs without it.
# Keep this server-side; callers must send it as a Bearer token.
# CONTEXT_QUERY_API_KEY=
# Use the Access Key ID / Secret Access Key R2 shows under "S3 clients" —
# not the Cloudflare API "Token Value", which is a different credential.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PREFIX=context-index
# Optional: only set this if R2 gave you a jurisdiction-specific endpoint
# (e.g. a bucket with an EU data-location restriction). Bare host, no
# protocol. Defaults to <R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# R2_ENDPOINT=
